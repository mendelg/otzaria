{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":approveMajorUpdates",
    ":enableVulnerabilityAlerts"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "timezone": "Asia/Jerusalem",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "ignorePaths": [
    "android/settings.gradle.kts"
  ],
  "packageRules": [
    {
      "description": "Flutter's Gradle plugins are supplied by the Flutter SDK, not Maven.",
      "matchPackageNames": [
        "dev.flutter.flutter-gradle-plugin:dev.flutter.flutter-gradle-plugin.gradle.plugin",
        "dev.flutter.flutter-plugin-loader:dev.flutter.flutter-plugin-loader.gradle.plugin"
      ],
      "enabled": false
    },
    {
      "description": "file_picker is pinned after an incompatible API update and needs explicit review.",
      "matchPackageNames": [
        "file_picker"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Wait for routine Dart and GitHub Actions updates to age before opening a PR.",
      "matchManagers": [
        "pub",
        "github-actions"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    }
  ]
}
